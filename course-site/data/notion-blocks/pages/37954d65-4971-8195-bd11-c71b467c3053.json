              "code": false,
              "color": "default"
            },
            "plain_text": "프롬프트 한 줄로 만든 ",
            "href": null
          },
          {
            "type": "text",
            "text": {
              "content": "작동하는 인터랙티브 웹페이지",
              "link": null
            },
            "annotations": {
              "bold": true,
              "italic": false,
