---
import Layout from '../layouts/Layout.astro';
import { modules } from '../data/modules';
import { syllabus } from '../data/syllabus';

const currentWeek = 'W01'; // 수동 업데이트
---

<Layout title="rpd — a studio.soluta series">
  <section class="wrap section hero">
    <p class="eyebrow">a studio.soluta series</p>
    <h1>Robot Product Design × AI</h1>
    <p class="lead">
      Blender와 AI 도구를 연결해 로봇 제품 디자인의 아이디에이션부터
      포트폴리오까지 실전으로 다룹니다.
    </p>
    <div class="meta-row">
      <span class="meta">2026 · 인하대학교</span>
      <span class="meta">15주 · R0–R5</span>
      <span class="meta">선수: SOLV M1~M3</span>
    </div>
  </section>

  <section class="wrap section">
    <header class="section-head">
      <h2>모듈</h2>
      <a href="/modules" class="more">전체 보기 →</a>
    </header>
    <ul class="module-grid">
      {modules.map((m) => (
        <li>
          <a href={`/modules/${m.id}`} class="module-card">
            <span class="module-label eyebrow">{m.label}</span>
            <span class="module-title">{m.title}</span>
            {m.week && <span class="meta">{m.week}부터</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section">
    <header class="section-head">
      <h2>강의 일정</h2>
      <a href="/syllabus" class="more">전체 보기 →</a>
    </header>
    <ul class="list">
      {syllabus.slice(0, 5).map((w) => (
        <li>
          <span class="week-row">
            <span class="meta week-no">{w.week}</span>
            <span class="week-title">{w.title}</span>
            {w.week === currentWeek && <span class="badge">진행 중</span>}
          </span>
        </li>
      ))}
    </ul>
    <a href="/syllabus" class="more more-link">전체 15주 일정 보기 →</a>
  </section>
</Layout>

<style>
  .hero { padding-bottom: 0; }
  .hero h1 {
    font-size: var(--fs-display);
    margin-top: var(--s-2);
    margin-bottom: var(--s-3);
  }
  .lead {
    font-size: var(--fs-md);
    color: var(--c-ink-2);
    max-width: var(--read-ko);
  }
  .meta-row {
    display: flex;
    gap: var(--s-4);
    margin-top: var(--s-4);
    flex-wrap: wrap;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--s-4);
  }
  .section-head h2 {
    font-family: var(--f-mono);
    font-size: var(--fs-lg);
    font-weight: var(--w-medium);
  }

  .module-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }
  @media (max-width: 560px) { .module-grid { grid-template-columns: 1fr; } }

  .module-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3);
    border: var(--border);
    border-radius: var(--r-lg);
    transition: border-color var(--t) var(--ease), background var(--t) var(--ease);
  }
  .module-card:hover {
    border-color: var(--c-ink-2);
    background: var(--c-bg-2);
    opacity: 1;
  }
  .module-title {
    font-size: var(--fs-sm);
    color: var(--c-ink);
    line-height: var(--lh-tight);
  }

  .list { border-top: var(--border); }
  .list li { border-bottom: var(--border); padding-block: var(--s-3); }
  .week-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .week-no { min-width: 2.5rem; }
  .week-title { font-size: var(--fs-sm); color: var(--c-ink); }
  .badge {
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    padding: 2px var(--s-2);
    background: var(--c-accent);
    color: var(--c-bg);
    border-radius: var(--r-pill);
    letter-spacing: var(--ls-mono);
  }
  .more {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    color: var(--c-accent);
    letter-spacing: var(--ls-mono);
  }
  .more-link { display: block; margin-top: var(--s-3); }
</style>
