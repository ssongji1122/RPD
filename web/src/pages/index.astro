---
import Layout from '../layouts/Layout.astro';
import { weeks, currentWeek } from '../data/curriculum';

const preview = weeks.slice(0, 6);
---

<Layout title="rpd — a studio.soluta series">
  <section class="wrap section hero">
    <p class="eyebrow">a studio.soluta series</p>
    <h1>Robot Product Design × AI</h1>
    <p class="lead">
      Blender 5.0과 AI 도구를 연결해 로봇·캐릭터 제품 디자인의
      모델링부터 렌더링·포트폴리오까지 실전으로 다룹니다.
    </p>
    <div class="meta-row">
      <span class="meta">2026 · 인하대학교</span>
      <span class="meta">{weeks.length}주 · Blender 5.0</span>
      <span class="meta">AI 3D · MCP</span>
    </div>
  </section>

  {currentWeek && (
    <section class="wrap section">
      <a href={`/weeks/${currentWeek.id}`} class="current-card">
        <span class="eyebrow">이번 주 · {currentWeek.id}</span>
        <strong class="current-title">{currentWeek.title}</strong>
        {currentWeek.subtitle && <span class="current-sub">{currentWeek.subtitle}</span>}
      </a>
    </section>
  )}

  <section class="wrap section">
    <header class="section-head">
      <h2>주차</h2>
      <a href="/weeks" class="more">전체 보기 →</a>
    </header>
    <ul class="week-grid">
      {preview.map((w) => (
        <li>
          <a href={`/weeks/${w.id}`} class="week-card">
            <span class="week-label eyebrow">{w.id}{w.phaseLabel && ` · ${w.phaseLabel}`}</span>
            <span class="week-title">{w.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <a href="/weeks" class="more more-link">전체 {weeks.length}주 보기 →</a>
  </section>
</Layout>

<style>
  .hero { padding-bottom: 0; }
  .hero h1 {
    font-size: var(--fs-display);
    margin-top: var(--s-2);
    margin-bottom: var(--s-3);
  }
  .lead {
    font-size: var(--fs-md);
    color: var(--c-ink-2);
    max-width: var(--read-ko);
    word-break: keep-all;
  }
  .meta-row {
    display: flex;
    gap: var(--s-4);
    margin-top: var(--s-4);
    flex-wrap: wrap;
  }

  .current-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-4);
    border: var(--border);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--c-accent) 6%, transparent);
    transition: border-color var(--t) var(--ease);
  }
  .current-card:hover { border-color: var(--c-accent); opacity: 1; }
  .current-title { font-size: var(--fs-lg); color: var(--c-ink); word-break: keep-all; }
  .current-sub { font-size: var(--fs-sm); color: var(--c-ink-2); word-break: keep-all; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--s-4);
  }
  .section-head h2 {
    font-family: var(--f-mono);
    font-size: var(--fs-lg);
    font-weight: var(--w-medium);
  }

  .week-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }
  @media (max-width: 560px) { .week-grid { grid-template-columns: 1fr; } }

  .week-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3);
    border: var(--border);
    border-radius: var(--r-lg);
    transition: border-color var(--t) var(--ease), background var(--t) var(--ease);
  }
  .week-card:hover {
    border-color: var(--c-ink-2);
    background: var(--c-bg-2);
    opacity: 1;
  }
  .week-card .week-title {
    font-size: var(--fs-sm);
    color: var(--c-ink);
    line-height: var(--lh-tight);
    word-break: keep-all;
  }

  .more {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    color: var(--c-accent);
    letter-spacing: var(--ls-mono);
  }
  .more-link { display: block; margin-top: var(--s-3); }
</style>
