---
import Layout from '../layouts/Layout.astro';
import { finalProjects, finalProjectsMeta } from '../data/finalProjects';
import type { FPMedia, FPProject } from '../data/finalProjects';

const { stats } = finalProjectsMeta;

// course-site final-projects.js 의 bestCover 로직 이식.
function bestCover(p: FPProject): FPMedia | null {
  if (p.coverSrc) {
    const c = p.media.find((m) => m.src === p.coverSrc);
    return c ?? { type: 'image', src: p.coverSrc, role: 'cover' };
  }
  const render = p.media.find((m) => m.role !== 'process' && m.type === 'image');
  if (render) return render;
  const video = p.media.find((m) => m.type === 'video');
  if (video) return video;
  return p.media[0] ?? null;
}

// editorial span: 영상은 2칸, 그 외 index%3==1 이면 2칸 (course-site editorialSpan).
const editorialSpan = (i: number, item: FPMedia) =>
  item.type === 'video' ? 2 : i % 3 === 1 ? 2 : 1;

const PRESENTATION = '발표 자료';
---

<Layout title="기말 작품 — rpd" description="RPD 기말 프로젝트 작품 아카이브">
  <section class="wrap section">
    <header class="fp-hero">
      <h1>기말 작품</h1>
      <p class="lead">Week 15 최종 프로젝트 아카이브 · 작품 {stats.works}점</p>
    </header>

    <!-- 필름스트립: 작품 커버 프레임 레일 (클릭 → 상세) -->
    <div class="fp-rail" role="list" aria-label="작품 목록">
      {finalProjects.map((p) => {
        const cover = bestCover(p);
        return (
          <a href={`#${p.id}`} class="fp-panel" role="listitem" aria-label={`${p.code} 보기`}>
            <span class="fp-frame">
              {cover ? (
                <img src={cover.src} alt="" loading="lazy" draggable="false" />
              ) : (
                <span class="fp-empty">—</span>
              )}
            </span>
            <span class="fp-panel-code meta">{p.code}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="wrap section fp-projects">
    {finalProjects.map((p) => {
      const cover = bestCover(p);
      const rest = p.media.filter((m) => m !== cover);
      const presentations = p.links.filter((l) => l.kind === PRESENTATION);
      const otherLinks = p.links.filter((l) => l.kind !== PRESENTATION);
      return (
        <article class="fp-project" id={p.id}>
          <div class="fp-grid">
            <div class="fp-cell fp-copy is-span-2">
              <h2 class="fp-title">{p.title}</h2>
              {presentations.length > 0 && (
                <ul class="fp-links fp-presentations">
                  {presentations.map((l) => (
                    <li>
                      <a href={l.url} target="_blank" rel="noopener" class="fp-pres-link">
                        {l.label} →
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {otherLinks.length > 0 && (
                <ul class="fp-links">
                  {otherLinks.map((l) => (
                    <li>
                      <a href={l.url} target="_blank" rel="noopener">
                        <span class="fp-link-tag meta">{l.kind}</span>{l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="fp-cell fp-media is-hero is-span-2">
              {cover && cover.type === 'video' && cover.videoSrc ? (
                <video controls playsinline preload="metadata" poster={cover.src}>
                  <source src={cover.videoSrc} type="video/mp4" />
                </video>
              ) : cover ? (
                <img src={cover.src} alt={`${p.code} 대표 이미지`} loading="lazy" />
              ) : (
                <span class="fp-empty">—</span>
              )}
            </div>

            {rest.map((m, i) => (
              <div class:list={['fp-cell', 'fp-media', `is-span-${editorialSpan(i, m)}`]}>
                {m.type === 'video' && m.videoSrc ? (
                  <video controls playsinline preload="none" poster={m.src}>
                    <source src={m.videoSrc} type="video/mp4" />
                  </video>
                ) : (
                  <img src={m.src} alt={`${p.code} 장면 ${i + 1}`} loading="lazy" />
                )}
              </div>
            ))}
          </div>
        </article>
      );
    })}
  </section>
</Layout>

<style>
  .fp-hero { margin-bottom: var(--s-5); }
  h1 { margin-bottom: var(--s-2); }
  .lead { color: var(--c-ink-2); }

  /* 필름스트립 레일 */
  .fp-rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-2);
  }
  .fp-panel { display: flex; flex-direction: column; gap: var(--s-1); }
  .fp-frame {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-bg-2);
    border: var(--border);
    border-radius: var(--r-md);
  }
  .fp-frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform var(--t) var(--ease);
  }
  .fp-panel:hover .fp-frame { border-color: var(--c-accent); }
  .fp-panel:hover .fp-frame img { transform: scale(1.04); }
  .fp-panel:hover { opacity: 1; }
  .fp-panel-code { color: var(--c-ink-3); }
  .fp-empty {
    display: grid; place-items: center;
    width: 100%; height: 100%;
    color: var(--c-ink-3);
  }
  @media (max-width: 700px) {
    .fp-rail { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* 작품 상세 — editorial 그리드 */
  .fp-projects { padding-top: 0; }
  .fp-project { scroll-margin-top: var(--s-6); margin-top: var(--s-7); }
  .fp-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: var(--border);
    border-left: var(--border);
    background: var(--c-bg);
  }
  .fp-cell {
    min-width: 0;
    border-right: var(--border);
    border-bottom: var(--border);
  }
  .fp-cell.is-span-2 { grid-column: span 2; }
  .fp-cell.is-span-4 { grid-column: span 4; }

  .fp-copy { display: grid; align-content: start; gap: var(--s-3); padding: var(--s-4); }
  .fp-title {
    margin: 0;
    font-family: var(--f-mono);
    font-size: var(--fs-lg);
    font-weight: var(--w-medium);
  }
  .fp-links { display: flex; flex-direction: column; gap: var(--s-2); }
  .fp-links a {
    display: inline-flex; align-items: baseline; gap: var(--s-2);
    font-size: var(--fs-sm); color: var(--c-accent);
  }
  .fp-link-tag {
    font-family: var(--f-mono); font-size: var(--fs-2xs);
    color: var(--c-ink-3); letter-spacing: var(--ls-mono);
  }
  .fp-pres-link {
    align-self: start;
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--c-accent);
    border-radius: var(--r-pill);
    color: var(--c-accent);
  }
  .fp-pres-link:hover { background: color-mix(in srgb, var(--c-accent) 12%, transparent); opacity: 1; }

  .fp-media { display: block; }
  .fp-media img, .fp-media video {
    width: 100%; height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    background: var(--c-bg-2);
  }
  .fp-media.is-hero img, .fp-media.is-hero video { aspect-ratio: 16 / 10; object-fit: contain; }

  @media (max-width: 700px) {
    .fp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fp-cell.is-span-2, .fp-cell.is-span-4 { grid-column: span 2; }
  }
</style>
