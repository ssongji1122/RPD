---
import Layout from '../layouts/Layout.astro';
import FinalFilmstrip from '../components/FinalFilmstrip.astro';
import { finalProjects, finalProjectsMeta } from '../data/finalProjects';
import type { FPLink, FPMedia, FPProject } from '../data/finalProjects';
import { displayTitle, isExcluded, isPublicNote, projectCounts, publicLinkUrl } from '../data/fpDisplay';

const { stats } = finalProjectsMeta;

// 데이터의 링크 kind 는 영어("Website" 등)로 저장된다 — 화면 의미로 정규화.
// course-site/assets/final-projects.js 의 linkKind 와 같은 매핑을 유지한다.
const KIND_ALIASES: Record<string, string> = {
  website: '웹페이지',
  '웹페이지': '웹페이지',
  'project page': '작품 페이지',
  '작품 페이지': '작품 페이지',
  presentation: '발표 자료',
  '발표 자료': '발표 자료',
  behance: 'Behance',
  board: 'Board',
  reference: 'Reference',
};
const kindOf = (l: FPLink) => KIND_ALIASES[(l.kind ?? '').trim().toLowerCase()] ?? l.kind;

const SITE_BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
// 사이트 내부 자산 링크(assets/…)는 base 를 붙여 절대 경로로 해석한다.
// 상대 그대로 두면 /final-projects/ 하위로 풀려 404 (project-18 로컬 HTML 사례).
const linkHref = (l: FPLink) => {
  const u = publicLinkUrl(l);
  return u.startsWith('assets/') ? `${SITE_BASE}/${u}` : u;
};
// course-site final-projects.js 의 bestCover 로직 이식.
function bestCover(p: FPProject): FPMedia | null {
  if (p.coverSrc) {
    const c = p.media.find((m) => m.src === p.coverSrc);
    return c ?? { type: 'image', src: p.coverSrc, role: 'cover' };
  }
  const render = p.media.find((m) => m.role !== 'process' && m.type === 'image');
  if (render) return render;
  const video = p.media.find((m) => m.type === 'video');
  if (video) return video;
  return p.media[0] ?? null;
}

function mediaGroups(p: FPProject, cover: FPMedia | null) {
  // 큐레이션 제외(의례 슬라이드·중복·개인정보)를 렌더에서 거른다. 커버는 유지.
  const rest = p.media.filter((m) => m !== cover && !isExcluded(m));
  return {
    outcome: rest.filter((m) => m.role !== 'process'),
    process: rest.filter((m) => m.role === 'process'),
  };
}

// 학생 노트에서 기본 소개에 쓸 한 줄 소개와 콘셉트 키워드를 찾는다. 학생이 적은 문구만
// 쓰고, 없으면 비워 둔다(지어내지 않는다).
const ONE_LINER = /한\s?줄\s?소개\s*[:：]\s*([^\n]+)/;
const KEYWORDS = /키워드[^\n#]*((?:#[^\s#]+\s*)+)/;
function introOf(notes: { text: string }[]) {
  const all = notes.map((n) => n.text).join('\n');
  const one = all.match(ONE_LINER)?.[1]?.trim();
  const kw = all.match(KEYWORDS)?.[1]?.trim().split(/\s+/).filter(Boolean) ?? [];
  return { oneLiner: one, keywords: kw };
}

// 학생 웹페이지 · 발표 자료 링크는 맨 위 버튼으로 올린다. 무드보드 · 레퍼런스는 작은 링크로 둔다.
const PRIMARY_KINDS = new Set(['웹페이지', '작품 페이지', '발표 자료', 'Behance']);
const isPrimaryLink = (l: FPLink) => PRIMARY_KINDS.has(kindOf(l));
const primaryHref = linkHref;
const primaryLabel = (l: FPLink) => (kindOf(l) === '발표 자료' ? '발표 자료 바로 가기' : '웹사이트 바로 가기');
---

<Layout title="기말 작품 — rpd" description="RPD 기말 프로젝트 작품 아카이브">
  <section class="wrap section fp-hero">
    <p class="eyebrow">(01) — Final Projects</p>
    <h1>기말 작품</h1>
    <p class="lead">Week 15 최종 프로젝트 아카이브 · 작품 {stats.works}점</p>
    <p class="fp-intro">
      로봇·캐릭터 컨셉 설정부터 모델링, 재질, 리깅, 애니메이션, 발표 웹페이지 제작까지 한 학기
      전 과정을 담은 최종 프로젝트 아카이브입니다. Meshy, 나노바나나, Kling, Suno, Mixamo,
      MCP 등 AI 도구를 제작 파이프라인에 결합했고, 작품별로 AI 활용 기록과 학생이 남긴 제작
      노트를 함께 수록했습니다.
    </p>
  </section>

  <!-- 필름스트립 (공유 컴포넌트) -->
  <FinalFilmstrip />

  <!-- 작품 상세 (editorial 그리드). 기본은 전부 접힌 목록, 필름스트립/링크 클릭이나
       #project-id 해시가 있으면 그 작품 하나만 펼쳐서 보여준다(course-site 원본의
       list/detail 라우팅과 동일한 UX — 24개 작품이 한 화면에 이어붙어 보이던 문제 해소). -->
  <section class="wrap section fp-projects" id="fpProjects">
    <div class="fp-projects-toolbar" id="fpToolbar" hidden>
      <button type="button" class="fp-back-to-list" id="fpBackToList">← 전체 목록으로</button>
    </div>
    {finalProjects.map((p) => {
      const cover = bestCover(p);
      const groups = mediaGroups(p, cover);
      const counts = projectCounts(p);
      const notes = (p.notes ?? []).filter(isPublicNote);
      const intro = introOf(notes);
      // 작품 내용은 학생 웹페이지 · 발표 자료에 다 있으므로, 이 페이지는 소개와 이미지만 두고
      // 학생 사이트로 바로 가는 버튼을 맨 위에 둔다.
      const primary = p.links.filter(isPrimaryLink);
      const secondary = p.links.filter((l) => !isPrimaryLink(l));
      return (
        <article class="fp-project" id={p.id}>
          <div class="fp-grid">
            <div class="fp-cell fp-copy is-span-2">
              <p class="fp-kicker meta">{p.code}</p>
              <h2 class="fp-title">{displayTitle(p)}</h2>
              {p.description ? (
                <p class="fp-desc">{p.description}</p>
              ) : (
                intro.oneLiner && <p class="fp-oneliner">{intro.oneLiner}</p>
              )}
              {intro.keywords.length > 0 && (
                <p class="fp-keywords meta">{intro.keywords.join(' ')}</p>
              )}
              <p class="fp-counts meta">
                이미지 {counts.images}장 · 영상 {counts.videos}개 · 과정 {counts.process}개
              </p>
              {primary.length > 0 && (
                <div class="fp-cta">
                  {primary.map((l, i) => (
                    <a class="fp-cta-btn" href={primaryHref(l)}>
                      {primaryLabel(l)}{primary.length > 1 ? ` ${i + 1}` : ''} →
                    </a>
                  ))}
                </div>
              )}
              {secondary.length > 0 && (
                <ul class="fp-links">
                  {secondary.map((l) => (
                    <li>
                      <a href={linkHref(l)} target="_blank" rel="noopener">
                        <span class="fp-link-tag meta">{kindOf(l)}</span>{l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="fp-cell fp-media is-hero is-span-2">
              {cover && cover.type === 'video' && cover.videoSrc ? (
                <video controls playsinline preload="metadata" poster={cover.src}>
                  <source src={cover.videoSrc} type="video/mp4" />
                </video>
              ) : cover ? (
                <img src={cover.src} alt={cover.caption ?? `${p.code} 대표 이미지`} loading="lazy" />
              ) : (
                <span class="fp-empty">—</span>
              )}
            </div>

            {[
              { key: 'process', label: '진행 과정', list: groups.process },
              { key: 'outcome', label: '완성 결과', list: groups.outcome },
            ]
              .filter((g) => g.list.length > 0)
              .map((g) => (
                <>
                  <div class="fp-section-label is-span-4">
                    <span>{g.label}</span>
                  </div>
                  <div class:list={['fp-cell', 'fp-gallery', 'is-span-4', `is-${g.key}`]}>
                    {g.list.map((m, i) => (
                      <figure class:list={[{ 'is-wide': m.type === 'video' }]}>
                        {m.type === 'video' && m.videoSrc ? (
                          <video controls playsinline preload="none" poster={m.src}>
                            <source src={m.videoSrc} type="video/mp4" />
                          </video>
                        ) : (
                          <img src={m.src} alt={m.caption ?? `${p.code} ${g.label} ${i + 1}`} loading="lazy" />
                        )}
                        {m.caption && <figcaption class="fp-caption">{m.caption}</figcaption>}
                      </figure>
                    ))}
                  </div>
                </>
              ))}

            {primary.length > 0 && (groups.process.length > 0 || groups.outcome.length > 0) && (
              <div class="fp-cell fp-cta-foot is-span-4">
                <p class="meta">작품 설명과 제작 과정은 학생 웹페이지에 정리돼 있습니다.</p>
                <div class="fp-cta">
                  {primary.map((l, i) => (
                    <a class="fp-cta-btn" href={primaryHref(l)}>
                      {primaryLabel(l)}{primary.length > 1 ? ` ${i + 1}` : ''} →
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </article>
      );
    })}
  </section>
</Layout>

<script>
  // 목록/상세 토글: #project-id 해시가 있으면 그 작품 하나만 보이고 나머지는 숨긴다.
  // 필름스트립 "OO 보기" 클릭·상세 링크는 전부 in-page 해시라 hashchange 로 반응한다.
  const list = document.getElementById('fpProjects');
  const toolbar = document.getElementById('fpToolbar');
  const backBtn = document.getElementById('fpBackToList');
  const projects = Array.from(document.querySelectorAll<HTMLElement>('.fp-project'));
  const filmSection = document.querySelector<HTMLElement>('.fp-film');

  function currentId() {
    return location.hash ? decodeURIComponent(location.hash.slice(1)) : '';
  }

  function applyView() {
    const id = currentId();
    const match = projects.find((p) => p.id === id);
    const isDetail = Boolean(match);

    projects.forEach((p) => {
      p.hidden = isDetail && p !== match;
    });
    if (toolbar) toolbar.hidden = !isDetail;
    if (filmSection) filmSection.hidden = isDetail;
    list?.classList.toggle('is-detail-view', isDetail);

    if (isDetail && match) {
      // 페이지 리로드/직접 진입 시 위치 보정 (뒤로가기에서는 스크롤 방해 안 함)
      requestAnimationFrame(() => match.scrollIntoView({ block: 'start' }));
    }
  }

  // 목록 뷰의 커버 클릭 → 그 작품 상세로 진입.
  projects.forEach((p) => {
    const hero = p.querySelector<HTMLElement>('.fp-media.is-hero');
    hero?.addEventListener('click', (e) => {
      if (list?.classList.contains('is-detail-view')) return;
      if ((e.target as HTMLElement).closest('a, button')) return;
      location.hash = p.id;
    });
  });

  backBtn?.addEventListener('click', () => {
    history.pushState('', document.title, location.pathname + location.search);
    applyView();
    window.scrollTo({ top: filmSection?.offsetTop ?? 0, behavior: 'smooth' });
  });

  window.addEventListener('hashchange', applyView);
  applyView();
</script>

<style>
  .fp-hero { padding-bottom: var(--s-4); }
  .fp-hero .eyebrow { color: var(--c-ink-3); }
  h1 { margin: var(--s-2) 0; }
  .lead { color: var(--c-ink-2); }
  .fp-empty { display: grid; place-items: center; width: 100%; height: 100%; color: var(--c-ink-3); }

  /* ── 목록/상세 토글 ── */
  .fp-projects-toolbar {
    display: flex;
    padding-bottom: var(--s-4);
    border-bottom: var(--border);
    margin-bottom: var(--s-6);
  }
  .fp-back-to-list {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-mono);
    color: var(--c-ink-2);
    background: none;
    border: var(--border);
    border-radius: var(--r-pill);
    padding: var(--s-2) var(--s-4);
    cursor: pointer;
  }
  .fp-back-to-list:hover { color: var(--c-ink); border-color: var(--c-accent); }
  /* 목록 뷰(기본): 커버 + 제목만 보이는 압축 카드. 전체 미디어 그리드(과정 기록·
     발표 자료 임베드 등)는 상세 뷰(#project-id 진입)에서만 편다 — 24개 작품의
     이미지가 한 화면에 계속 이어지며 뒤섞여 보이던 문제의 근본 해결책. */
  .fp-projects:not(.is-detail-view) .fp-project { margin-top: var(--s-9, 96px); }
  .fp-projects:not(.is-detail-view) .fp-project:first-child { margin-top: 0; }
  .fp-projects:not(.is-detail-view) .fp-copy { position: relative; }
  .fp-projects:not(.is-detail-view) .fp-copy::before {
    content: '';
    position: absolute;
    top: calc(-1 * var(--s-4));
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--c-accent);
  }
  .fp-projects:not(.is-detail-view) .fp-grid { grid-template-rows: auto; }
  .fp-projects:not(.is-detail-view) .fp-cell.fp-media.is-hero {
    cursor: pointer;
  }
  .fp-projects:not(.is-detail-view) .fp-cell.fp-media:not(.is-hero),
  .fp-projects:not(.is-detail-view) .fp-gallery,
  .fp-projects:not(.is-detail-view) .fp-cta-foot,
  .fp-projects:not(.is-detail-view) .fp-section-label {
    display: none;
  }
  .fp-projects:not(.is-detail-view) .fp-media.is-hero video { pointer-events: none; }

  /* ── 작품 상세 (editorial) ── */
  .fp-projects { padding-top: var(--s-6); }
  .fp-project { scroll-margin-top: var(--s-6); margin-top: var(--s-7); }
  .fp-project:first-child { margin-top: 0; }
  .fp-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: var(--border);
    border-left: var(--border);
  }
  .fp-cell { min-width: 0; border-right: var(--border); border-bottom: var(--border); }
  .fp-cell.is-span-2 { grid-column: span 2; }
  .fp-cell.is-span-4 { grid-column: 1 / -1; }
  .fp-section-label {
    grid-column: 1 / -1;
    min-width: 0;
    padding: var(--s-2) var(--s-4);
    border-right: var(--border);
    border-bottom: var(--border);
  }
  .fp-desc { margin: 0; font-size: var(--fs-sm); color: var(--c-ink-2); line-height: 1.75; word-break: keep-all; max-width: 60ch; }
  .fp-projects:not(.is-detail-view) .fp-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .fp-oneliner { margin: 0; font-size: var(--fs-md); color: var(--c-ink); line-height: 1.5; word-break: keep-all; }
  .fp-keywords { margin: 0; color: var(--c-accent-text); }
  .fp-section-label span {
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    color: var(--c-ink-2);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .fp-copy { display: grid; align-content: start; gap: var(--s-3); padding: var(--s-4); }
  .fp-kicker,
  .fp-counts {
    margin: 0;
    color: var(--c-ink-3);
  }
  .fp-title { margin: 0; font-family: var(--f-mono); font-size: var(--fs-lg); font-weight: var(--w-medium); }
  .fp-links { display: flex; flex-direction: column; gap: var(--s-2); }
  .fp-links a { display: inline-flex; align-items: baseline; gap: var(--s-2); font-size: var(--fs-sm); color: var(--c-accent-text); }
  .fp-link-tag { font-family: var(--f-mono); font-size: var(--fs-2xs); color: var(--c-ink-3); letter-spacing: var(--ls-mono); }
  .fp-intro {
    max-width: var(--max); /* 880px — 컨테이너 관례 폭. 62ch 는 한글 기준 ~470px 라 너무 좁았다 */
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: 1.7;
    word-break: keep-all;
  }

  /* 학생 사이트로 가는 버튼: 상세 맨 위와 맨 아래에 같은 모양으로 둔다 */
  .fp-cta { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .fp-cta-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-4);
    border-radius: var(--r-pill);
    background: var(--c-ink);
    color: var(--c-bg);
    font-size: var(--fs-sm);
    font-weight: var(--w-medium);
  }
  .fp-cta-btn:hover { background: var(--c-accent); color: var(--c-bg); opacity: 1; }
  .fp-cta-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4);
  }
  .fp-cta-foot p { margin: 0; color: var(--c-ink-2); }

  /* 진행 과정 · 완성 결과: 같은 크기 칸에 통째로 보여 주는 격자. 영상만 한 줄 전체를 쓴다 */
  .fp-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
    padding: var(--s-4);
  }
  .fp-gallery.is-process { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .fp-gallery figure { margin: 0; min-width: 0; }
  .fp-gallery figure.is-wide { grid-column: 1 / -1; }
  /* 빈 여백에 배경을 깔지 않고 이미지 원래 비율 그대로 둔다 */
  .fp-gallery { align-items: start; }
  .fp-gallery img, .fp-gallery video {
    display: block;
    width: 100%;
    height: auto;
  }
  .fp-gallery figure.is-wide video { aspect-ratio: 16 / 9; max-height: min(72vh, 720px); }
  .fp-caption {
    margin: var(--s-1) 0 0;
    font-size: var(--fs-2xs);
    color: var(--c-ink-2);
    line-height: 1.6;
    word-break: keep-all;
  }
  @media (max-width: 700px) {
    .fp-gallery, .fp-gallery.is-process { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .fp-media { display: block; }
  .fp-media img, .fp-media video {
    width: 100%; height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .fp-media.is-hero img, .fp-media.is-hero video { aspect-ratio: 16 / 10; object-fit: contain; }
  /* ── 상세 뷰: 소개와 대표 이미지를 나란히 두어 버튼이 첫 화면에 보이게 한다 ── */
  .fp-projects.is-detail-view .fp-media.is-hero img,
  .fp-projects.is-detail-view .fp-media.is-hero video {
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }
  @media (max-width: 700px) {
    .fp-projects.is-detail-view .fp-cell.fp-copy,
    .fp-projects.is-detail-view .fp-cell.fp-media.is-hero { grid-column: 1 / -1; }
  }

  @media (max-width: 700px) {
    .fp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fp-cell.is-span-2 { grid-column: span 2; }
  }
</style>
