---
import Layout from '../layouts/Layout.astro';
import FinalFilmstrip from '../components/FinalFilmstrip.astro';
import { finalProjects, finalProjectsMeta } from '../data/finalProjects';
import type { FPLink, FPMedia, FPProject } from '../data/finalProjects';

const { stats } = finalProjectsMeta;

// 데이터의 링크 kind 는 영어("Website" 등)로 저장된다 — 화면 의미로 정규화.
// course-site/assets/final-projects.js 의 linkKind 와 같은 매핑을 유지한다.
const KIND_ALIASES: Record<string, string> = {
  website: '웹페이지',
  '웹페이지': '웹페이지',
  'project page': '작품 페이지',
  '작품 페이지': '작품 페이지',
  presentation: '발표 자료',
  '발표 자료': '발표 자료',
  behance: 'Behance',
  board: 'Board',
  reference: 'Reference',
};
const kindOf = (l: FPLink) => KIND_ALIASES[(l.kind ?? '').trim().toLowerCase()] ?? l.kind;

const SITE_BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
// 사이트 내부 자산 링크(assets/…)는 base 를 붙여 절대 경로로 해석한다.
// 상대 그대로 두면 /final-projects/ 하위로 풀려 404 (project-18 로컬 HTML 사례).
const linkHref = (l: FPLink) => {
  const u = (l.url ?? '').trim();
  return u.startsWith('assets/') ? `${SITE_BASE}/${u}` : u;
};
// iframe 이 차단되는 호스트(Notion, Mixboard 등)는 일반 링크로 남긴다.
const EMBED_BLOCKED = /notion\.(so|site)|mixboard\.google\.com|canva\.link|21st\.dev|godly\.website/;

interface EmbedInfo {
  src: string;
  openUrl: string;
  provider: string;
  label: string;
}

// 발표 자료·웹 작품을 페이지 안에서 볼 수 있게 임베드 URL 을 계산한다.
// Canva 는 빌드 데이터에 미리 해석된 embedUrl(view?embed)을 쓴다.
function embedFor(l: FPLink): EmbedInfo | null {
  const url = (l.url ?? '').trim();
  const label = l.label || kindOf(l);
  if (l.embedUrl) return { src: l.embedUrl, openUrl: url, provider: 'Canva', label };
  const slides = url.match(/docs\.google\.com\/presentation\/d\/([A-Za-z0-9_-]+)/);
  if (slides) {
    return {
      src: `https://docs.google.com/presentation/d/${slides[1]}/embed?start=false&loop=false&delayms=3000`,
      openUrl: url,
      provider: 'Google Slides',
      label,
    };
  }
  const behance = url.match(/behance\.net\/gallery\/(\d+)/i);
  if (behance) {
    return {
      src: `https://www.behance.net/embed/project/${behance[1]}?ilo0=1`,
      openUrl: url,
      provider: 'Behance',
      label,
    };
  }
  if (url.startsWith('assets/')) {
    const local = `${SITE_BASE}/${url}`;
    return { src: local, openUrl: local, provider: 'Website', label };
  }
  const kind = kindOf(l);
  if (
    (kind === '웹페이지' || kind === '작품 페이지') &&
    /^https?:\/\//.test(url) &&
    !EMBED_BLOCKED.test(url)
  ) {
    const https = url.replace(/^http:/, 'https:');
    return { src: https, openUrl: https, provider: 'Website', label };
  }
  return null;
}

// course-site final-projects.js 의 bestCover 로직 이식.
function bestCover(p: FPProject): FPMedia | null {
  if (p.coverSrc) {
    const c = p.media.find((m) => m.src === p.coverSrc);
    return c ?? { type: 'image', src: p.coverSrc, role: 'cover' };
  }
  const render = p.media.find((m) => m.role !== 'process' && m.type === 'image');
  if (render) return render;
  const video = p.media.find((m) => m.type === 'video');
  if (video) return video;
  return p.media[0] ?? null;
}

// 완성 결과 미디어 스팬: 영상은 전폭(4), 이미지는 반폭(2)씩 두 장 짝.
// 연속 이미지 묶음이 홀수면 마지막 장을 전폭으로 승격해 빈 칸을 없앤다.
function mediaSpans(list: FPMedia[]): number[] {
  const spans = list.map((m) => (m.type === 'video' ? 4 : 2));
  let runStart = -1;
  for (let i = 0; i <= list.length; i++) {
    const isImage = i < list.length && list[i].type !== 'video';
    if (isImage && runStart === -1) runStart = i;
    if (!isImage && runStart !== -1) {
      if ((i - runStart) % 2 === 1) spans[i - 1] = 4;
      runStart = -1;
    }
  }
  return spans;
}

function mediaGroups(p: FPProject, cover: FPMedia | null) {
  const rest = p.media.filter((m) => m !== cover);
  return {
    outcome: rest.filter((m) => m.role !== 'process'),
    process: rest.filter((m) => m.role === 'process'),
  };
}

function projectCounts(p: FPProject) {
  return {
    // 이미지는 완성 컷만 센다 — 과정 캡처는 별도 항목이라 중복 집계 방지.
    images: p.media.filter((m) => m.type === 'image' && m.role !== 'process').length,
    videos: p.videos.length || p.media.filter((m) => m.type === 'video').length,
    process: p.media.filter((m) => m.role === 'process').length,
  };
}

const PRESENTATION = '발표 자료';
---

<Layout title="기말 작품 — rpd" description="RPD 기말 프로젝트 작품 아카이브">
  <section class="wrap section fp-hero">
    <p class="eyebrow">(01) — Final Projects</p>
    <h1>기말 작품</h1>
    <p class="lead">Week 15 최종 프로젝트 아카이브 · 작품 {stats.works}점</p>
    <p class="fp-intro">
      로봇·캐릭터 컨셉 설정부터 모델링, 재질, 리깅, 애니메이션, 발표 웹페이지 제작까지 한 학기
      전 과정을 담은 최종 프로젝트 아카이브입니다. Meshy, 나노바나나, Kling, Suno, Mixamo,
      MCP 등 AI 도구를 제작 파이프라인에 결합했고, 작품별로 AI 활용 기록과 학생이 남긴 제작
      노트를 함께 수록했습니다.
    </p>
  </section>

  <!-- 필름스트립 (공유 컴포넌트) -->
  <FinalFilmstrip />

  <!-- 작품 상세 (editorial 그리드). 기본은 전부 접힌 목록, 필름스트립/링크 클릭이나
       #project-id 해시가 있으면 그 작품 하나만 펼쳐서 보여준다(course-site 원본의
       list/detail 라우팅과 동일한 UX — 24개 작품이 한 화면에 이어붙어 보이던 문제 해소). -->
  <section class="wrap section fp-projects" id="fpProjects">
    <div class="fp-projects-toolbar" id="fpToolbar" hidden>
      <button type="button" class="fp-back-to-list" id="fpBackToList">← 전체 목록으로</button>
    </div>
    {finalProjects.map((p) => {
      const cover = bestCover(p);
      const groups = mediaGroups(p, cover);
      const counts = projectCounts(p);
      const presentations = p.links.filter((l) => kindOf(l) === PRESENTATION);
      const otherLinks = p.links.filter((l) => kindOf(l) !== PRESENTATION);
      const embeds = p.links.flatMap((l) => {
        const e = embedFor(l);
        return e ? [e] : [];
      });
      const notes = p.notes ?? [];
      // 상세 섹션은 제작 흐름 순서(과정 → 완성 → 발표·웹)로 배치하고,
      // 실제로 존재하는 섹션만 이어 붙여 번호를 매긴다.
      const secOrder = [
        ['process', groups.process.length > 0 || notes.length > 0],
        ['outcome', groups.outcome.length > 0],
        ['embeds', embeds.length > 0],
      ]
        .filter(([, has]) => has)
        .map(([key]) => key);
      const secNo = (key: string) => String(secOrder.indexOf(key) + 1).padStart(2, '0');
      return (
        <article class="fp-project" id={p.id}>
          <div class="fp-grid">
            <div class="fp-cell fp-copy is-span-2">
              <p class="fp-kicker meta">{p.code}</p>
              <h2 class="fp-title">{p.workTitle ?? p.title}</h2>
              <p class="fp-counts meta">
                이미지 {counts.images}장 · 영상 {counts.videos}개 · 과정 {counts.process}개
              </p>
              {presentations.length > 0 && (
                <ul class="fp-links">
                  {presentations.map((l) => (
                    <li><a href={linkHref(l)} target="_blank" rel="noopener" class="fp-pres-link">{l.label} →</a></li>
                  ))}
                </ul>
              )}
              {otherLinks.length > 0 && (
                <ul class="fp-links">
                  {otherLinks.map((l) => (
                    <li>
                      <a href={linkHref(l)} target="_blank" rel="noopener">
                        <span class="fp-link-tag meta">{kindOf(l)}</span>{l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="fp-cell fp-media is-hero is-span-2">
              {cover && cover.type === 'video' && cover.videoSrc ? (
                <video controls playsinline preload="metadata" poster={cover.src}>
                  <source src={cover.videoSrc} type="video/mp4" />
                </video>
              ) : cover ? (
                <img src={cover.src} alt={`${p.code} 대표 이미지`} loading="lazy" />
              ) : (
                <span class="fp-empty">—</span>
              )}
            </div>

            {(groups.process.length > 0 || notes.length > 0) && (
              <div class="fp-section-label is-span-4">
                <span>{secNo('process')} — AI 활용 과정</span>
              </div>
            )}
            {notes.length > 0 && (
              <div class="fp-cell fp-notes is-span-4">
                <p class="fp-notes-head meta">학생 제작 노트 — 노션 제출 페이지 원문</p>
                <ul>
                  {notes.map((n) => (
                    <li>
                      {n.section && <span class="fp-note-tag meta">{n.section}</span>}
                      <span class="fp-note-text">{n.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {groups.process.map((m, i) => (
              <div class:list={['fp-cell', 'fp-media', 'is-process', `is-span-${mediaSpans(groups.process)[i]}`]}>
                {m.type === 'video' && m.videoSrc ? (
                  <video controls playsinline preload="none" poster={m.src}>
                    <source src={m.videoSrc} type="video/mp4" />
                  </video>
                ) : (
                  <img src={m.src} alt={`${p.code} 과정 ${i + 1}`} loading="lazy" />
                )}
              </div>
            ))}

            {groups.outcome.length > 0 && (
              <div class="fp-section-label is-span-4">
                <span>{secNo('outcome')} — 완성 결과</span>
              </div>
            )}
            {groups.outcome.map((m, i) => (
              <div class:list={['fp-cell', 'fp-media', `is-span-${mediaSpans(groups.outcome)[i]}`]}>
                {m.type === 'video' && m.videoSrc ? (
                  <video controls playsinline preload="none" poster={m.src}>
                    <source src={m.videoSrc} type="video/mp4" />
                  </video>
                ) : (
                  <img src={m.src} alt={`${p.code} 장면 ${i + 1}`} loading="lazy" />
                )}
              </div>
            ))}

            {embeds.length > 0 && (
              <div class="fp-section-label is-span-4">
                <span>{secNo('embeds')} — 발표 자료 · 웹</span>
              </div>
            )}
            {embeds.map((e) => (
              <div class="fp-cell fp-embed is-span-4">
                <div class="fp-embed-head">
                  <span class="meta">{e.provider}</span>
                  <a href={e.openUrl} target="_blank" rel="noopener">새 탭에서 열기 →</a>
                </div>
                <iframe
                  src={e.src}
                  title={`${p.code} ${e.provider} — ${e.label}`}
                  loading="lazy"
                  allow="autoplay; fullscreen"
                  allowfullscreen
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
            ))}

          </div>
        </article>
      );
    })}
  </section>
</Layout>

<script>
  // 목록/상세 토글: #project-id 해시가 있으면 그 작품 하나만 보이고 나머지는 숨긴다.
  // 필름스트립 "OO 보기" 클릭·상세 링크는 전부 in-page 해시라 hashchange 로 반응한다.
  const list = document.getElementById('fpProjects');
  const toolbar = document.getElementById('fpToolbar');
  const backBtn = document.getElementById('fpBackToList');
  const projects = Array.from(document.querySelectorAll<HTMLElement>('.fp-project'));
  const filmSection = document.querySelector<HTMLElement>('.fp-film');

  function currentId() {
    return location.hash ? decodeURIComponent(location.hash.slice(1)) : '';
  }

  function applyView() {
    const id = currentId();
    const match = projects.find((p) => p.id === id);
    const isDetail = Boolean(match);

    projects.forEach((p) => {
      p.hidden = isDetail && p !== match;
    });
    if (toolbar) toolbar.hidden = !isDetail;
    if (filmSection) filmSection.hidden = isDetail;
    list?.classList.toggle('is-detail-view', isDetail);

    if (isDetail && match) {
      // 페이지 리로드/직접 진입 시 위치 보정 (뒤로가기에서는 스크롤 방해 안 함)
      requestAnimationFrame(() => match.scrollIntoView({ block: 'start' }));
    }
  }

  // 목록 뷰의 커버 클릭 → 그 작품 상세로 진입.
  projects.forEach((p) => {
    const hero = p.querySelector<HTMLElement>('.fp-media.is-hero');
    hero?.addEventListener('click', (e) => {
      if (list?.classList.contains('is-detail-view')) return;
      if ((e.target as HTMLElement).closest('a, button')) return;
      location.hash = p.id;
    });
  });

  backBtn?.addEventListener('click', () => {
    history.pushState('', document.title, location.pathname + location.search);
    applyView();
    window.scrollTo({ top: filmSection?.offsetTop ?? 0, behavior: 'smooth' });
  });

  window.addEventListener('hashchange', applyView);
  applyView();
</script>

<style>
  .fp-hero { padding-bottom: var(--s-4); }
  .fp-hero .eyebrow { color: var(--c-ink-3); }
  h1 { margin: var(--s-2) 0; }
  .lead { color: var(--c-ink-2); }
  .fp-empty { display: grid; place-items: center; width: 100%; height: 100%; color: var(--c-ink-3); }

  /* ── 목록/상세 토글 ── */
  .fp-projects-toolbar {
    display: flex;
    padding-bottom: var(--s-4);
    border-bottom: var(--border);
    margin-bottom: var(--s-6);
  }
  .fp-back-to-list {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-mono);
    color: var(--c-ink-2);
    background: none;
    border: var(--border);
    border-radius: var(--r-pill);
    padding: var(--s-2) var(--s-4);
    cursor: pointer;
  }
  .fp-back-to-list:hover { color: var(--c-ink); border-color: var(--c-accent); }
  /* 목록 뷰(기본): 커버 + 제목만 보이는 압축 카드. 전체 미디어 그리드(과정 기록·
     발표 자료 임베드 등)는 상세 뷰(#project-id 진입)에서만 편다 — 24개 작품의
     이미지가 한 화면에 계속 이어지며 뒤섞여 보이던 문제의 근본 해결책. */
  .fp-projects:not(.is-detail-view) .fp-project { margin-top: var(--s-9, 96px); }
  .fp-projects:not(.is-detail-view) .fp-project:first-child { margin-top: 0; }
  .fp-projects:not(.is-detail-view) .fp-copy { position: relative; }
  .fp-projects:not(.is-detail-view) .fp-copy::before {
    content: '';
    position: absolute;
    top: calc(-1 * var(--s-4));
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--c-accent);
  }
  .fp-projects:not(.is-detail-view) .fp-grid { grid-template-rows: auto; }
  .fp-projects:not(.is-detail-view) .fp-cell.fp-media.is-hero {
    cursor: pointer;
  }
  .fp-projects:not(.is-detail-view) .fp-cell.fp-media:not(.is-hero),
  .fp-projects:not(.is-detail-view) .fp-embed,
  .fp-projects:not(.is-detail-view) .fp-section-label {
    display: none;
  }
  .fp-projects:not(.is-detail-view) .fp-media.is-hero video { pointer-events: none; }

  /* ── 작품 상세 (editorial) ── */
  .fp-projects { padding-top: var(--s-6); }
  .fp-project { scroll-margin-top: var(--s-6); margin-top: var(--s-7); }
  .fp-project:first-child { margin-top: 0; }
  .fp-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: var(--border);
    border-left: var(--border);
  }
  .fp-cell { min-width: 0; border-right: var(--border); border-bottom: var(--border); }
  .fp-cell.is-span-2 { grid-column: span 2; }
  .fp-cell.is-span-4 { grid-column: 1 / -1; }
  .fp-section-label {
    grid-column: 1 / -1;
    min-width: 0;
    padding: var(--s-2) var(--s-4);
    border-right: var(--border);
    border-bottom: var(--border);
    background: var(--c-bg-2);
  }
  .fp-section-label span {
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    color: var(--c-ink-2);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .fp-copy { display: grid; align-content: start; gap: var(--s-3); padding: var(--s-4); }
  .fp-kicker,
  .fp-counts {
    margin: 0;
    color: var(--c-ink-3);
  }
  .fp-title { margin: 0; font-family: var(--f-mono); font-size: var(--fs-lg); font-weight: var(--w-medium); }
  .fp-links { display: flex; flex-direction: column; gap: var(--s-2); }
  .fp-links a { display: inline-flex; align-items: baseline; gap: var(--s-2); font-size: var(--fs-sm); color: var(--c-accent); }
  .fp-link-tag { font-family: var(--f-mono); font-size: var(--fs-2xs); color: var(--c-ink-3); letter-spacing: var(--ls-mono); }
  .fp-copy .fp-pres-link {
    align-self: start;
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--c-accent);
    border-radius: var(--r-pill);
    color: var(--c-accent);
  }
  .fp-copy .fp-pres-link:hover { background: color-mix(in srgb, var(--c-accent) 12%, transparent); opacity: 1; }

  .fp-intro {
    max-width: var(--max); /* 880px — 컨테이너 관례 폭. 62ch 는 한글 기준 ~470px 라 너무 좁았다 */
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: 1.7;
    word-break: keep-all;
  }

  .fp-notes { padding: var(--s-4); }
  .fp-notes-head {
    margin: 0 0 var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    color: var(--c-ink-3);
    letter-spacing: var(--ls-mono);
  }
  .fp-notes ul {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fp-notes li {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
  }
  .fp-note-tag {
    flex-shrink: 0;
    min-width: 5.5em;
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    color: var(--c-ink-3);
    letter-spacing: var(--ls-mono);
  }
  .fp-note-text {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: 1.7;
    word-break: keep-all;
    white-space: pre-line;
  }

  .fp-embed { display: grid; grid-template-rows: auto 1fr; }
  .fp-embed-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-4);
    border-bottom: var(--border);
  }
  .fp-embed-head .meta {
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    color: var(--c-ink-3);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }
  .fp-embed-head a { font-size: var(--fs-sm); color: var(--c-accent); }
  .fp-embed iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border: 0;
    background: var(--c-bg-2);
  }

  .fp-media { display: block; }
  .fp-media img, .fp-media video {
    width: 100%; height: 100%;
