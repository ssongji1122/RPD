---
import Layout from '../layouts/Layout.astro';
import { finalProjects, finalProjectsMeta } from '../data/finalProjects';
import type { FPMedia, FPProject } from '../data/finalProjects';

const { stats } = finalProjectsMeta;

// course-site final-projects.js 의 bestCover 로직 이식.
function bestCover(p: FPProject): FPMedia | null {
  if (p.coverSrc) {
    const c = p.media.find((m) => m.src === p.coverSrc);
    return c ?? { type: 'image', src: p.coverSrc, role: 'cover' };
  }
  const render = p.media.find((m) => m.role !== 'process' && m.type === 'image');
  if (render) return render;
  const video = p.media.find((m) => m.type === 'video');
  if (video) return video;
  return p.media[0] ?? null;
}

const editorialSpan = (i: number, item: FPMedia) =>
  item.type === 'video' ? 2 : i % 3 === 1 ? 2 : 1;

const PRESENTATION = '발표 자료';
const firstPres = (p: FPProject) => p.links.find((l) => l.kind === PRESENTATION);
---

<Layout title="기말 작품 — rpd" description="RPD 기말 프로젝트 작품 아카이브">
  <section class="wrap section fp-hero">
    <p class="eyebrow">(01) — Final Projects</p>
    <h1>기말 작품</h1>
    <p class="lead">Week 15 최종 프로젝트 아카이브 · 작품 {stats.works}점</p>
  </section>

  <!-- 필름스트립: 가운데 큰 히어로 + 양옆 썸네일, 좌우로 탐색 -->
  <section class="fp-film" aria-label="작품 필름스트립">
    <button class="fp-nav fp-prev" id="fpPrev" type="button" aria-label="이전 작품">←</button>
    <div class="fp-stage">
      <div class="fp-track" id="fpTrack">
        {finalProjects.map((p, i) => {
          const cover = bestCover(p);
          const pres = firstPres(p);
          return (
            <button
              class="fp-slide"
              type="button"
              data-idx={i}
              data-code={p.code}
              data-title={p.title}
              data-detail={`#${p.id}`}
              data-pres-url={pres?.url ?? ''}
              aria-label={`${p.code} 보기`}
            >
              <span class="fp-slide-frame">
                {cover ? <img src={cover.src} alt={p.code} loading={i < 6 ? 'eager' : 'lazy'} draggable="false" /> : <span class="fp-empty">—</span>}
              </span>
            </button>
          );
        })}
      </div>
    </div>
    <button class="fp-nav fp-next" id="fpNext" type="button" aria-label="다음 작품">→</button>

    <div class="fp-film-info">
      <span class="fp-film-idx meta" id="fpIdx">(01 / {stats.works})</span>
      <strong class="fp-film-title" id="fpTitle">작품 01</strong>
      <span class="fp-film-actions">
        <a id="fpPres" class="fp-pres-link" href="#" target="_blank" rel="noopener" hidden>발표 자료 →</a>
        <a id="fpDetail" class="fp-detail-link" href="#project-01">작품 상세 ↓</a>
      </span>
    </div>
  </section>

  <!-- 작품 상세 (editorial 그리드) -->
  <section class="wrap section fp-projects">
    {finalProjects.map((p) => {
      const cover = bestCover(p);
      const rest = p.media.filter((m) => m !== cover);
      const presentations = p.links.filter((l) => l.kind === PRESENTATION);
      const otherLinks = p.links.filter((l) => l.kind !== PRESENTATION);
      return (
        <article class="fp-project" id={p.id}>
          <div class="fp-grid">
            <div class="fp-cell fp-copy is-span-2">
              <h2 class="fp-title">{p.title}</h2>
              {presentations.length > 0 && (
                <ul class="fp-links">
                  {presentations.map((l) => (
                    <li><a href={l.url} target="_blank" rel="noopener" class="fp-pres-link">{l.label} →</a></li>
                  ))}
                </ul>
              )}
              {otherLinks.length > 0 && (
                <ul class="fp-links">
                  {otherLinks.map((l) => (
                    <li>
                      <a href={l.url} target="_blank" rel="noopener">
                        <span class="fp-link-tag meta">{l.kind}</span>{l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="fp-cell fp-media is-hero is-span-2">
              {cover && cover.type === 'video' && cover.videoSrc ? (
                <video controls playsinline preload="metadata" poster={cover.src}>
                  <source src={cover.videoSrc} type="video/mp4" />
                </video>
              ) : cover ? (
                <img src={cover.src} alt={`${p.code} 대표 이미지`} loading="lazy" />
              ) : (
                <span class="fp-empty">—</span>
              )}
            </div>

            {rest.map((m, i) => (
              <div class:list={['fp-cell', 'fp-media', `is-span-${editorialSpan(i, m)}`]}>
                {m.type === 'video' && m.videoSrc ? (
                  <video controls playsinline preload="none" poster={m.src}>
                    <source src={m.videoSrc} type="video/mp4" />
                  </video>
                ) : (
                  <img src={m.src} alt={`${p.code} 장면 ${i + 1}`} loading="lazy" />
                )}
              </div>
            ))}
          </div>
        </article>
      );
    })}
  </section>
</Layout>

<script>
  const track = document.getElementById('fpTrack');
  const stage = track?.parentElement as HTMLElement | null;
  const slides = Array.from(document.querySelectorAll<HTMLButtonElement>('.fp-slide'));
  const idxEl = document.getElementById('fpIdx');
  const titleEl = document.getElementById('fpTitle');
  const detailEl = document.getElementById('fpDetail') as HTMLAnchorElement | null;
  const presEl = document.getElementById('fpPres') as HTMLAnchorElement | null;
  const total = slides.length;
  let active = 0;

  function center() {
    if (!track || !stage || !slides[active]) return;
    const s = slides[active];
    const target = s.offsetLeft + s.offsetWidth / 2;
    track.style.transform = `translateX(${stage.clientWidth / 2 - target}px)`;
    slides.forEach((el, i) => el.classList.toggle('is-active', i === active));

    const s2 = slides[active];
    if (idxEl) idxEl.textContent = `(${String(active + 1).padStart(2, '0')} / ${total})`;
    if (titleEl) titleEl.textContent = s2.dataset.title || s2.dataset.code || '';
    if (detailEl) detailEl.setAttribute('href', s2.dataset.detail || '#');
    if (presEl) {
      const url = s2.dataset.presUrl;
      if (url) { presEl.setAttribute('href', url); presEl.hidden = false; }
      else presEl.hidden = true;
    }
  }

  function setActive(i: number) {
    active = Math.max(0, Math.min(total - 1, i));
    center();
  }

  slides.forEach((s, i) => s.addEventListener('click', () => setActive(i)));
  document.getElementById('fpPrev')?.addEventListener('click', () => setActive(active - 1));
  document.getElementById('fpNext')?.addEventListener('click', () => setActive(active + 1));
  stage?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); setActive(active - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); setActive(active + 1); }
  });
  let raf = 0;
  window.addEventListener('resize', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(center); });
  // 이미지가 로드되며 폭이 바뀌면 재정렬
  slides.forEach((s) => s.querySelector('img')?.addEventListener('load', center));
  center();
</script>

<style>
  .fp-hero { padding-bottom: var(--s-4); }
  .fp-hero .eyebrow { color: var(--c-ink-3); }
  h1 { margin: var(--s-2) 0; }
  .lead { color: var(--c-ink-2); }

  /* ── 필름스트립 ── */
  .fp-film {
    position: relative;
    padding: var(--s-5) 0 var(--s-6);
    border-block: var(--border);
    overflow: hidden;
  }
  .fp-stage {
    overflow: hidden;
    width: 100%;
  }
  .fp-track {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 360px;
    will-change: transform;
    transition: transform 0.55s var(--ease);
  }
  .fp-slide {
    flex: 0 0 auto;
    width: 132px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    transition: width 0.55s var(--ease);
  }
  .fp-slide-frame {
    display: block;
    width: 100%;
    height: 180px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--r-sm);
    background: var(--c-bg-2);
    transition: height 0.55s var(--ease), border-color var(--t) var(--ease);
  }
  .fp-slide-frame img { width: 100%; height: 100%; object-fit: cover; }
  .fp-slide:hover .fp-slide-frame { border-color: var(--c-ink-2); }
  /* 가운데(활성) 슬라이드 = 히어로 */
  .fp-slide.is-active { width: 300px; }
  .fp-slide.is-active .fp-slide-frame {
    height: 360px;
    border-color: var(--c-accent);
  }
  .fp-empty { display: grid; place-items: center; width: 100%; height: 100%; color: var(--c-ink-3); }

  .fp-nav {
    position: absolute;
    top: calc(var(--s-5) + 180px);
    transform: translateY(-50%);
    z-index: 2;
    width: 40px; height: 40px;
    display: grid; place-items: center;
    font-family: var(--f-mono); font-size: var(--fs-md);
    color: var(--c-ink);
    background: var(--c-bg);
    border: var(--border);
    border-radius: var(--r-circle);
    cursor: pointer;
    transition: border-color var(--t) var(--ease), color var(--t) var(--ease);
  }
  .fp-nav:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .fp-prev { left: var(--gut); }
  .fp-next { right: var(--gut); }

  .fp-film-info {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-4);
    padding-inline: var(--gut);
  }
  .fp-film-idx { font-family: var(--f-mono); color: var(--c-ink-3); }
  .fp-film-title { font-size: var(--fs-md); color: var(--c-ink); }
  .fp-film-actions { display: flex; gap: var(--s-3); margin-left: auto; }
  .fp-detail-link, .fp-film-actions .fp-pres-link {
    font-family: var(--f-mono); font-size: var(--fs-sm);
    letter-spacing: var(--ls-mono);
  }
  .fp-detail-link { color: var(--c-ink-2); }
  .fp-detail-link:hover { color: var(--c-ink); }

  /* ── 작품 상세 (editorial) ── */
  .fp-projects { padding-top: var(--s-6); }
  .fp-project { scroll-margin-top: var(--s-6); margin-top: var(--s-7); }
  .fp-project:first-child { margin-top: 0; }
  .fp-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: var(--border);
    border-left: var(--border);
  }
  .fp-cell { min-width: 0; border-right: var(--border); border-bottom: var(--border); }
  .fp-cell.is-span-2 { grid-column: span 2; }

  .fp-copy { display: grid; align-content: start; gap: var(--s-3); padding: var(--s-4); }
  .fp-title { margin: 0; font-family: var(--f-mono); font-size: var(--fs-lg); font-weight: var(--w-medium); }
  .fp-links { display: flex; flex-direction: column; gap: var(--s-2); }
  .fp-links a { display: inline-flex; align-items: baseline; gap: var(--s-2); font-size: var(--fs-sm); color: var(--c-accent); }
  .fp-link-tag { font-family: var(--f-mono); font-size: var(--fs-2xs); color: var(--c-ink-3); letter-spacing: var(--ls-mono); }
  .fp-copy .fp-pres-link {
    align-self: start;
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--c-accent);
    border-radius: var(--r-pill);
    color: var(--c-accent);
  }
  .fp-copy .fp-pres-link:hover { background: color-mix(in srgb, var(--c-accent) 12%, transparent); opacity: 1; }

  .fp-media { display: block; }
  .fp-media img, .fp-media video {
    width: 100%; height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    background: var(--c-bg-2);
  }
  .fp-media.is-hero img, .fp-media.is-hero video { aspect-ratio: 16 / 10; object-fit: contain; }

  @media (max-width: 700px) {
    .fp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fp-cell.is-span-2 { grid-column: span 2; }
    .fp-slide.is-active { width: 240px; }
  }
</style>
