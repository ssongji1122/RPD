---
import Layout from '../layouts/Layout.astro';
import { weeks, currentWeek } from '../data/curriculum';
---

<Layout title="강의 일정 — rpd" description={`rpd ${weeks.length}주 강의 일정`}>
  <section class="wrap section">
    <h1>강의 일정</h1>
    <p class="lead">2026학년도 · {weeks.length}주 · 인하대학교</p>

    <ul class="syllabus-list">
      {weeks.map((w) => (
        <li class="week-item">
          <span class="week-no meta">{w.id}</span>
          <div class="week-body">
            <div class="week-head">
              <a href={`/weeks/${w.id}`} class="week-title">{w.title}</a>
              {w.phaseLabel && <span class="type-badge eyebrow">{w.phaseLabel}</span>}
              {w.id === currentWeek.id && <span class="badge">진행 중</span>}
            </div>
            {w.subtitle && <p class="week-desc">{w.subtitle}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  h1 { margin-bottom: var(--s-2); }
  .lead { color: var(--c-ink-2); margin-bottom: var(--s-6); }

  .syllabus-list { border-top: var(--border); }
  .week-item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: var(--border);
  }
  .week-no { padding-top: 2px; }
  .week-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-1);
    flex-wrap: wrap;
  }
  .week-title {
    font-size: var(--fs-base);
    font-weight: var(--w-medium);
    color: var(--c-ink);
    word-break: keep-all;
  }
  .week-title:hover { color: var(--c-accent); opacity: 1; }
  .week-desc { font-size: var(--fs-sm); color: var(--c-ink-2); word-break: keep-all; }
  .type-badge {
    padding: 2px var(--s-2);
    background: var(--c-bg-2);
    border-radius: var(--r-pill);
    color: var(--c-ink-3);
  }
  .badge {
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    padding: 2px var(--s-2);
    background: var(--c-accent);
    color: var(--c-bg);
    border-radius: var(--r-pill);
    letter-spacing: var(--ls-mono);
  }
</style>
