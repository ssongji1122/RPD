---
import { url } from '../lib/url';

const norm = (p: string) => p.replace(/\/$/, '') || '/';
const pathname = norm(Astro.url.pathname);
const isActive = (href: string) => {
  const target = norm(url(href));
  return href === '/' ? pathname === target : pathname.startsWith(target);
};

// 상단에는 자주 가는 3개만. 나머지는 "수업 ▾" 드롭다운으로.
const primary = [
  { href: '/weeks', label: 'weeks' },
  { href: '/library', label: 'library' },
  { href: '/final-projects', label: 'final' },
];
const menu = [
  { href: '/syllabus', label: 'syllabus' },
  { href: '/shortcuts', label: 'shortcuts' },
  { href: '/resources', label: 'resources' },
  { href: '/inha', label: 'inha' },
];
const menuActive = menu.some((l) => isActive(l.href));
---

<header>
  <div class="wrap header-inner">
    <a href={url('/')} class="brand">
      <span class="brand-main">rpd</span>
      <span class="brand-sub">a studio.soluta series</span>
    </a>
    <nav>
      {primary.map((l) => (
        <a href={url(l.href)} class:list={[{ active: isActive(l.href) }]}>
          {l.label}
        </a>
      ))}
      <details class="nav-menu" id="navMenu">
        <summary class:list={['nav-summary', { active: menuActive }]}>
          수업<span class="nav-caret" aria-hidden="true">▾</span>
        </summary>
        <div class="nav-dropdown">
          {menu.map((l) => (
            <a href={url(l.href)} class:list={[{ active: isActive(l.href) }]}>
              {l.label}
            </a>
          ))}
        </div>
      </details>
      <button id="themeToggle" class="theme-toggle" type="button" aria-label="라이트/다크 전환">
        <svg class="icon-sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--c-line);
    background: var(--c-bg);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .brand-main {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    font-weight: var(--w-medium);
    color: var(--c-ink);
    letter-spacing: 0.02em;
  }
  .brand-sub {
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    color: var(--c-ink-3);
    letter-spacing: var(--ls-mono);
  }
  nav { display: flex; align-items: center; gap: var(--s-4); }
  nav a {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--c-ink-2);
    transition: color var(--t) var(--ease);
  }
  nav > a:hover { color: var(--c-ink); opacity: 1; }
  nav > a.active { color: var(--c-ink); }

  /* ── 수업 드롭다운 ── */
  .nav-menu { position: relative; }
  .nav-summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--c-ink-2);
    cursor: pointer;
    list-style: none;
    transition: color var(--t) var(--ease);
  }
  .nav-summary::-webkit-details-marker { display: none; }
  .nav-summary:hover, .nav-summary.active { color: var(--c-ink); }
  .nav-caret { font-size: 9px; transition: transform var(--t) var(--ease); }
  .nav-menu[open] .nav-caret { transform: rotate(180deg); }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 8rem;
    padding: var(--s-3) var(--s-4);
    background: var(--c-bg);
    border: var(--border);
    border-radius: var(--r-md);
    z-index: var(--z-sticky);
  }
  .nav-dropdown a {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--c-ink-2);
    white-space: nowrap;
    transition: color var(--t) var(--ease);
  }
  .nav-dropdown a:hover { color: var(--c-ink); opacity: 1; }
  .nav-dropdown a.active { color: var(--c-ink); }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    color: var(--c-ink-2);
    background: none;
    border: var(--border);
    border-radius: var(--r-circle);
    cursor: pointer;
    transition: color var(--t) var(--ease), border-color var(--t) var(--ease);
  }
  .theme-toggle:hover { color: var(--c-ink); border-color: var(--c-ink-2); }
  .theme-toggle svg { display: block; }
  /* 현재 테마 표시: 라이트면 해, 다크면 달 */
  :global([data-theme='light']) .theme-toggle .icon-moon { display: none; }
  :global([data-theme='dark']) .theme-toggle .icon-sun { display: none; }

  @media (max-width: 560px) {
    .brand-sub { display: none; }
    nav { gap: var(--s-3); }
  }
</style>

<script>
  // 수업 드롭다운: 바깥 클릭·Esc·링크 클릭 시 닫기
  const navMenu = document.getElementById('navMenu') as HTMLDetailsElement | null;
  if (navMenu) {
    document.addEventListener('click', (e) => {
      if (navMenu.open && !navMenu.contains(e.target as Node)) navMenu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navMenu.open) navMenu.open = false;
    });
    navMenu.querySelectorAll('.nav-dropdown a').forEach((a) =>
      a.addEventListener('click', () => { navMenu.open = false; })
    );
  }

  const btn = document.getElementById('themeToggle');
  btn?.addEventListener('click', () => {
    const cur = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    const next = cur === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* localStorage 불가 시 무시 */
    }
  });
</script>
