---
import type { Week } from '../data/curriculum';
import { url } from '../lib/url';

interface Props {
  week: Week;
  compact?: boolean;
}

const { week, compact = false } = Astro.props;

function stepImages(w: Week): string[] {
  return w.steps.flatMap((step) => {
    if (step.image == null) return [];
    return Array.isArray(step.image) ? step.image : [step.image];
  });
}

function assetUrl(src: string): string {
  return url(src.startsWith('/') ? src : `/${src}`);
}

const thumbnail = stepImages(week)[0];
const statusLabel = week.status === 'active' ? '진행 중' : week.status === 'done' ? '완료' : '예정';
const stats = [
  `${week.steps.length}단계`,
  week.topics.length ? `주제 ${week.topics.length}` : '',
  week.shortcuts.length ? `단축키 ${week.shortcuts.length}` : '',
  week.docs.length + week.videos.length ? `자료 ${week.docs.length + week.videos.length}` : '',
].filter(Boolean);
---

<a href={url(`/weeks/${week.id}`)} class:list={['lesson-card', { compact, active: week.status === 'active' }]}>
  <span class="lesson-media" aria-hidden="true">
    {thumbnail ? (
      <img src={assetUrl(thumbnail)} alt="" loading="lazy" />
    ) : (
      <span class="lesson-fallback">
        <span>{week.id}</span>
        {week.phaseLabel && <small>{week.phaseLabel}</small>}
      </span>
    )}
  </span>
  <span class="lesson-body">
    <span class="lesson-meta">
      <span class="meta">{week.id}{week.phaseLabel && ` · ${week.phaseLabel}`}</span>
      <span class="lesson-status">{statusLabel}</span>
    </span>
    <strong>{week.title}</strong>
    {week.subtitle && !compact && <span class="lesson-sub">{week.subtitle}</span>}
    <span class="lesson-stats meta">{stats.join(' · ')}</span>
  </span>
</a>

<style>
  .lesson-card {
    display: grid;
    grid-template-columns: minmax(120px, 0.42fr) minmax(0, 1fr);
    min-height: 168px;
    border: var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-bg);
    transition: border-color var(--t) var(--ease), background var(--t) var(--ease);
  }
  .lesson-card:hover {
    border-color: var(--c-ink-2);
    background: var(--c-bg-2);
    opacity: 1;
  }
  .lesson-card.active {
    border-color: var(--c-accent);
  }
  .lesson-media {
    min-width: 0;
    background: var(--c-bg-2);
    border-right: var(--border);
  }
  .lesson-media img {
    width: 100%;
    height: 100%;
    min-height: 168px;
    object-fit: cover;
  }
  .lesson-fallback {
    display: grid;
    place-content: center;
    gap: var(--s-1);
    width: 100%;
    height: 100%;
    min-height: 168px;
    font-family: var(--f-mono);
    color: var(--c-ink-3);
  }
  .lesson-fallback span {
    font-size: var(--fs-xl);
    color: var(--c-ink);
  }
  .lesson-fallback small {
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-mono);
  }
  .lesson-body {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    min-width: 0;
    padding: var(--s-3);
  }
  .lesson-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
  }
  .lesson-status {
    flex: 0 0 auto;
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    color: var(--c-accent);
    letter-spacing: var(--ls-mono);
  }
  strong {
    font-size: var(--fs-base);
    font-weight: var(--w-medium);
    line-height: var(--lh-tight);
    color: var(--c-ink);
    word-break: keep-all;
  }
  .lesson-sub {
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--c-ink-2);
    word-break: keep-all;
  }
  .lesson-stats {
    color: var(--c-ink-3);
  }
  .lesson-card.compact {
    grid-template-columns: 96px minmax(0, 1fr);
    min-height: 124px;
  }
  .lesson-card.compact .lesson-media img,
  .lesson-card.compact .lesson-fallback {
    min-height: 124px;
  }
  @media (max-width: 620px) {
    .lesson-card,
    .lesson-card.compact {
      grid-template-columns: 1fr;
    }
    .lesson-media {
      border-right: 0;
      border-bottom: var(--border);
    }
    .lesson-media img,
    .lesson-fallback,
    .lesson-card.compact .lesson-media img,
    .lesson-card.compact .lesson-fallback {
      min-height: 150px;
      max-height: 180px;
    }
  }
</style>
