---
import { finalProjects, finalProjectsMeta } from '../data/finalProjects';
import type { FPMedia, FPProject } from '../data/finalProjects';

interface Props {
  // 작품 상세 앵커 prefix. 같은 페이지(final-projects)면 '' (in-page 앵커),
  // 홈처럼 다른 페이지면 final-projects URL을 넘겨 그 페이지 앵커로 이동.
  detailBase?: string;
}
const { detailBase = '' } = Astro.props;

const { stats } = finalProjectsMeta;

// course-site final-projects.js 의 bestCover 로직 이식.
function bestCover(p: FPProject): FPMedia | null {
  if (p.coverSrc) {
    const c = p.media.find((m) => m.src === p.coverSrc);
    return c ?? { type: 'image', src: p.coverSrc, role: 'cover' };
  }
  const render = p.media.find((m) => m.role !== 'process' && m.type === 'image');
  if (render) return render;
  const video = p.media.find((m) => m.type === 'video');
  if (video) return video;
  return p.media[0] ?? null;
}

const PRESENTATION = '발표 자료';
const firstPres = (p: FPProject) => p.links.find((l) => l.kind === PRESENTATION);
const projectSummary = (p: FPProject) => {
  const images = p.media.filter((m) => m.type === 'image').length;
  const videos = p.videos.length || p.media.filter((m) => m.type === 'video').length;
  return `이미지 ${images} · 영상 ${videos}`;
};

// 무한 루프: 슬라이드를 3벌 렌더해 양옆(특히 왼쪽)이 항상 채워지게 한다.
// 중앙 세트를 기준으로 순환하고, 경계를 넘으면 무애니메이션으로 스냅(아래 스크립트).
const realTotal = finalProjects.length;
const COPIES = 3;
const looped = Array.from({ length: COPIES * realTotal }, (_, di) => ({ p: finalProjects[di % realTotal], di, real: di % realTotal }));
// 초기 중앙(real 0, 중앙 세트) 주변만 eager 로드.
const eager = (di: number) => di >= realTotal - 4 && di <= realTotal + 6;
---

<!-- 필름스트립: 가운데 큰 히어로 + 양옆 썸네일, 좌우로 탐색 -->
<section class="fp-film" aria-label="작품 필름스트립">
  <button class="fp-nav fp-prev" id="fpPrev" type="button" aria-label="이전 작품">←</button>
  <div class="fp-stage">
    <div class="fp-track" id="fpTrack" data-real-total={realTotal}>
      {looped.map(({ p, di, real }) => {
        const cover = bestCover(p);
        const pres = firstPres(p);
        const isClone = di < realTotal || di >= 2 * realTotal;
        return (
          <button
            class="fp-slide"
            type="button"
            data-idx={di}
            data-real={real}
            data-side={di === realTotal ? 'center' : di < realTotal ? 'left' : 'right'}
            data-code={p.code}
            data-title={p.workTitle ?? p.title}
            data-detail={`${detailBase}#${p.id}`}
            data-pres-url={pres?.url ?? ''}
            aria-label={`${p.code} 보기`}
            aria-hidden={isClone ? 'true' : undefined}
            tabindex={isClone ? -1 : undefined}
          >
            <span class="fp-slide-frame">
              {cover ? <img src={cover.src} alt={p.code} loading={eager(di) ? 'eager' : 'lazy'} draggable="false" /> : <span class="fp-empty">—</span>}
              <span class="fp-slide-caption" aria-hidden="true">
                <strong>{p.code}</strong>
                <span>{projectSummary(p)}</span>
              </span>
            </span>
          </button>
        );
      })}
    </div>
  </div>
  <button class="fp-nav fp-next" id="fpNext" type="button" aria-label="다음 작품">→</button>

  <div class="fp-film-info">
    <span class="fp-film-idx meta" id="fpIdx">(01 / {stats.works})</span>
    <strong class="fp-film-title" id="fpTitle">작품 01</strong>
    <span class="fp-film-actions">
      <a id="fpPres" class="fp-pres-link" href="#" target="_blank" rel="noopener" hidden>발표 자료 →</a>
      <a id="fpDetail" class="fp-detail-link" href={`${detailBase}#project-01`}>작품 상세 ↓</a>
    </span>
  </div>
</section>

<script>
  const track = document.getElementById('fpTrack');
  const stage = track?.parentElement as HTMLElement | null;
  const slides = Array.from(document.querySelectorAll<HTMLButtonElement>('.fp-slide'));
  const idxEl = document.getElementById('fpIdx');
  const titleEl = document.getElementById('fpTitle');
  const detailEl = document.getElementById('fpDetail') as HTMLAnchorElement | null;
  const presEl = document.getElementById('fpPres') as HTMLAnchorElement | null;
  const realTotal = Number(track?.dataset.realTotal || slides.length) || slides.length;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // 임계 감쇠 스프링 강성(rad/s). 지수 감쇠와 달리 속도가 0에서 이어져
  // 출발이 급하지 않고(가속→감속 S-곡선), 연타·호버로 목표가 바뀌어도
  // 진행 중 속도를 그대로 물려받아 오버슈트 없이 액체처럼 따라붙는다.
  const OMEGA = 8;

  // 중앙 세트(real 0)에서 시작 — 좌우가 항상 클론으로 채워진다.
  let pos = realTotal;

  const inBand = (p: number) => p >= realTotal && p < 2 * realTotal;
  const modReal = (p: number) => ((p % realTotal) + realTotal) % realTotal;

  // 활성 슬라이드를 스테이지 정중앙에 두는 translateX 목표값(현재 레이아웃 기준).
  function goalX(): number {
    const s = slides[pos];
    if (!track || !stage || !s) return 0;
    return stage.clientWidth / 2 - (s.offsetLeft + s.offsetWidth / 2);
  }

  let currentX = 0;
  function apply(x: number) {
    if (track) track.style.transform = `translate3d(${x.toFixed(2)}px,0,0)`;
  }

  function updateInfo() {
    const s = slides[pos];
    if (!s) return;
    const real = ((pos % realTotal) + realTotal) % realTotal;
    if (idxEl) idxEl.textContent = `(${String(real + 1).padStart(2, '0')} / ${realTotal})`;
    if (titleEl) titleEl.textContent = s.dataset.title || s.dataset.code || '';
    if (detailEl) detailEl.setAttribute('href', s.dataset.detail || '#');
    if (presEl) {
      const url = s.dataset.presUrl;
      if (url) { presEl.setAttribute('href', url); presEl.hidden = false; }
      else presEl.hidden = true;
    }
  }

  function setActive() {
    slides.forEach((el, i) => {
      el.classList.toggle('is-active', i === pos);
      // 커버 플로우: 활성 기준 좌/우를 표시해 CSS 가 양옆을 원근 기울임 처리.
      el.dataset.side = i === pos ? 'center' : i < pos ? 'left' : 'right';
    });
  }

  // 경계 밖(첫/세번째 세트)이면 동일하게 보이는 중앙 세트 슬라이드로 스왑.
  // 폭/높이 transition 을 잠시 꺼(no-anim) 클래스 이동이 즉시 반영되게 하고,
  // 스왑 전후 목표값 차이만큼 currentX 를 함께 밀어 화면상 1px 도 안 튀게 한다.
  function normalize() {
    if (!track || inBand(pos)) return;
    const before = goalX();
    track.classList.add('no-anim');
    pos = realTotal + modReal(pos);
    setActive();
    void track.offsetWidth; // 억제된 상태로 최종 레이아웃 확정
    const after = goalX();
    track.classList.remove('no-anim');
    currentX += after - before;
    apply(currentX);
  }

  // ── 스무딩 루프 ──
  // 목표가 움직여도(폭 grow, 연타, 호버 재타깃) 항상 현재 위치에서 이어지는 한 곡선.
  // 목표 도달 + 목표 정지(폭 애니메이션 종료)가 몇 프레임 지속되면 스냅 후 정지.
  let rafId = 0;
  let lastT = 0;
  let prevGoal = 0;
  let settled = 0;
  let vx = 0; // 스프링 속도(px/s) — 재타깃 간에도 이어진다

  function tick(t: number) {
    const dt = Math.min(0.048, lastT ? (t - lastT) / 1000 : 0.016);
    lastT = t;
    const goal = goalX();
    // 임계 감쇠 스프링의 닫힌형 해 — 프레임레이트와 무관하게 안정.
    const e = Math.exp(-OMEGA * dt);
    const dx = currentX - goal;
    const tmp = (vx + OMEGA * dx) * dt;
    currentX = goal + (dx + tmp) * e;
    vx = (vx - OMEGA * tmp) * e;
    apply(currentX);
    const still =
      Math.abs(goal - currentX) < 0.4 && Math.abs(vx) < 15 && Math.abs(goal - prevGoal) < 0.1;
    prevGoal = goal;
    settled = still ? settled + 1 : 0;
    if (settled >= 6) {
      currentX = goal;
      vx = 0;
      apply(currentX);
      normalize();
      rafId = 0;
      lastT = 0;
      return;
    }
    rafId = requestAnimationFrame(tick);
  }

  function startLoop() {
    settled = 0;
    if (!rafId) { lastT = 0; rafId = requestAnimationFrame(tick); }
  }

  function moveTo(target: number) {
    // 클론 세트 깊숙이 달아나면(빠른 연타) 남은 여유가 없어지기 전에 미리 스왑.
    if (target < realTotal / 2 || target >= realTotal * 2.5) {
      pos = target;
      normalize();
    } else {
      pos = target;
    }
    setActive();
    updateInfo();
    if (reduceMotion) {
      currentX = goalX();
      apply(currentX);
      normalize();
      return;
    }
    startLoop();
  }

  function go(delta: number) { moveTo(pos + delta); }

  // 호버: 커서가 가리키는 썸네일을 가운데로. mouseenter 가 아니라 pointermove 에만
  // 반응해, 가운데 이동으로 커서 밑 슬라이드가 바뀌어도 커서가 안 움직였으면 재발동 안 한다.
  let hoverTimer = 0;
  stage?.addEventListener('pointermove', (e) => {
    if ((e as PointerEvent).pointerType === 'touch') return;
    const slide = (e.target as HTMLElement).closest('.fp-slide') as HTMLButtonElement | null;
    if (!slide) return;
    const i = slides.indexOf(slide);
    if (i === -1 || i === pos) return;
    clearTimeout(hoverTimer);
    hoverTimer = window.setTimeout(() => moveTo(i), 60);
  });
  stage?.addEventListener('pointerleave', () => clearTimeout(hoverTimer));

  // 클릭: 옆 썸네일이면 가운데로 이동, 이미 가운데(활성)면 상세로 이동.
  // "누르면 무조건 그 자리서 이동"이 아니라 한 번 중앙에 세운 뒤 열게 해 오클릭을 없앤다.
  slides.forEach((s, i) => {
    s.addEventListener('click', () => {
      clearTimeout(hoverTimer);
      if (i === pos) {
        const href = s.dataset.detail;
        if (href) window.location.href = href;
      } else {
        moveTo(i);
      }
    });
  });

  document.getElementById('fpPrev')?.addEventListener('click', () => go(-1));
  document.getElementById('fpNext')?.addEventListener('click', () => go(1));
  stage?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
  });

  // 리사이즈·이미지 로드로 폭이 바뀌면 재정렬 — 이동 중이면 루프가 알아서 따라가고,
  // 정지 상태면 애니메이션 없이 즉시 스냅.
  function reflowSnap() {
    if (rafId) return; // 루프가 새 목표를 자연스럽게 추적
    currentX = goalX();
    apply(currentX);
  }
  let resizeRaf = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(reflowSnap);
  });
  slides.forEach((s) => s.querySelector('img')?.addEventListener('load', reflowSnap));

  // 초기 배치 — 스냅 후 루프를 걸어, 히어로가 132→340px 로 자라는 동안의
  // 중심 이동까지 추적해 정중앙에 정착시킨다(일회성 스냅만 하면 성장분만큼 어긋난다).
  setActive();
  updateInfo();
  currentX = goalX();
  apply(currentX);
  if (!reduceMotion) startLoop();
</script>

<style>
  /* ── 필름스트립 ── */
  .fp-film {
    position: relative;
    padding: var(--s-5) 0 var(--s-6);
    border-block: var(--border);
    overflow: hidden;
  }
  .fp-stage { overflow: hidden; width: 100%; }
  .fp-track {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 360px;
    will-change: transform;
    /* transform 은 JS 가 매 프레임 히어로 중심에 맞춰 구동한다(CSS transition 없음). */
    /* 커버 플로우: 자식 rotateY 가 공유 소실점을 갖게 한다. */
    perspective: 1100px;
  }
  .fp-slide {
    flex: 0 0 auto;
    width: 132px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    transition: width 0.55s var(--ease);
  }
  /* 무한 루프 경계 스왑 순간: 클래스 이동을 즉시 반영해 화면이 튀지 않게 한다(JS normalize). */
  .fp-track.no-anim .fp-slide,
  .fp-track.no-anim .fp-slide-frame {
    transition: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .fp-slide,
    .fp-slide-frame,
    .fp-slide-caption {
      transition: none !important;
    }
  }
  .fp-slide-frame {
    display: block;
    position: relative;
    width: 100%;
    height: 180px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--r-lg);
    background: var(--c-bg-2);
    transition: height 0.55s var(--ease), transform 0.45s var(--ease), border-color var(--t) var(--ease);
  }
  /* 커버 플로우: 양옆 썸네일을 안쪽으로 기울인다. 활성(히어로)만 정면. */
  .fp-slide[data-side='left'] .fp-slide-frame { transform: rotateY(26deg) scale(0.97); }
  .fp-slide[data-side='right'] .fp-slide-frame { transform: rotateY(-26deg) scale(0.97); }
  .fp-slide.is-active .fp-slide-frame { transform: none; }
  .fp-slide-frame img { width: 100%; height: 100%; object-fit: cover; }
  .fp-slide-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 2px;
    padding: var(--s-2);
    background: var(--c-bg);
    border-top: var(--border);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
    pointer-events: none;
  }
  .fp-slide-caption strong,
  .fp-slide-caption span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .fp-slide-caption strong {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--c-ink);
  }
  .fp-slide-caption span {
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    color: var(--c-ink-3);
    letter-spacing: var(--ls-mono);
  }

  /* 호버하면 그 썸네일이 가운데로 이동(JS)해 히어로로 커진다. 살짝 강조만. */
  .fp-slide:not(.is-active):hover .fp-slide-frame { border-color: var(--c-ink-2); }

  /* 가운데(활성) 슬라이드 = 히어로 */
  .fp-slide.is-active { width: clamp(300px, 22vw, 340px); }
  .fp-slide.is-active .fp-slide-frame {
    height: 360px;
    border-color: var(--c-accent);
  }
  .fp-slide:hover .fp-slide-caption,
  .fp-slide:focus-visible .fp-slide-caption,
  .fp-slide.is-active .fp-slide-caption {
    opacity: 1;
    transform: translateY(0);
  }
  .fp-empty { display: grid; place-items: center; width: 100%; height: 100%; color: var(--c-ink-3); }

  .fp-nav {
    position: absolute;
    top: calc(var(--s-5) + 180px);
    transform: translateY(-50%);
    z-index: 2;
    width: 40px; height: 40px;
    display: grid; place-items: center;
    font-family: var(--f-mono); font-size: var(--fs-md);
    color: var(--c-ink);
    background: var(--c-bg);
    border: var(--border);
    border-radius: var(--r-circle);
    cursor: pointer;
    transition: border-color var(--t) var(--ease), color var(--t) var(--ease);
  }
  .fp-nav:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .fp-prev { left: var(--gut); }
  .fp-next { right: var(--gut); }

  .fp-film-info {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-4);
    padding-inline: var(--gut);
  }
  .fp-film-idx { font-family: var(--f-mono); color: var(--c-ink-3); }
  .fp-film-title { font-size: var(--fs-md); color: var(--c-ink); }
  .fp-film-actions { display: flex; gap: var(--s-3); margin-left: auto; }
  .fp-detail-link, .fp-film-actions .fp-pres-link {
    font-family: var(--f-mono); font-size: var(--fs-sm);
    letter-spacing: var(--ls-mono);
  }
  .fp-detail-link { color: var(--c-ink-2); }
  .fp-detail-link:hover { color: var(--c-ink); }

  @media (max-width: 700px) {
    .fp-slide.is-active { width: min(240px, calc(100vw - 120px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-slide,
    .fp-slide-frame,
    .fp-slide-caption { transition: none; }
  }
</style>
