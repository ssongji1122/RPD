---
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap footer-inner">
    <div>
      <p class="brand">rpd</p>
      <p class="tagline">Robot Product Design × AI — a studio.soluta series</p>
    </div>
    <div>
      <p class="meta">© {year} studio.soluta</p>
      <p class="meta">soluta.studio</p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--c-line);
    padding-block: var(--s-7);
    margin-top: var(--s-9);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--c-ink);
  }
  .tagline {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    margin-top: var(--s-1);
  }
  .meta {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: var(--ls-mono);
  }
  .meta + .meta { margin-top: var(--s-1); }
  .meta a { color: var(--c-accent); }
</style>
