---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'rpd — a studio.soluta series',
  description = 'Robot Product Design × AI. Blender와 AI 도구로 각자의 작품을 구상하고 결과물로 완성하는 수업.',
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F8F6F0" />
    <!-- 테마 초기화: 저장값 우선, 없으면 라이트(studio.soluta) 기본. OS 다크 무시. FOUC 방지로 head 에서 즉시 적용. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          document.documentElement.dataset.theme = t === 'dark' || t === 'light' ? t : 'light';
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
